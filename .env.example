JWT_SECRET_KEY=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
TOP_K=5
MIN_RELEVANCE_SCORE=0.55
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_TYPES=application/pdf
